  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Capitulo2.EstacionPuenteCapitulo2
  transformGuia: {fileID: 255236272}
  puntoDestinoGuia: {fileID: 65525186}
  camaraEstacion: {fileID: 1563714228}
  transformCamara: {fileID: 1563714229}
  puntoDestinoCamara: {fileID: 833529891}
  panelDialogo: {fileID: 1121776465}
  textoDialogo: {fileID: 1527206691}
  botonContinuar: {fileID: 303930960}
  velocidadTypewriter: 0.055
  guiaAnimator: {fileID: 255236271}
  parametroHablando: Hablando
  imagenDanoConfirmado: {fileID: 666238120}
  imagenProteccionInterpretativa: {fileID: 1563572315}
  duracionFadeImagen: 0.65
  panelConfirmacionConceptos: {fileID: 1027045585}
  textoPreguntaConfirmacion: {fileID: 2100726946}
  textoPreguntaConfirmacionStr: "\xBFEntendiste los conceptos DA\xD1O CONFIRMADO
    y PROTECCI\xD3N INTERPRETATIVA?"
  botonExplicarDeNuevo: {fileID: 1120572485}
  botonVerdeExplicarDeNuevo: {fileID: 1445849106}
  botonLoEntendi: {fileID: 2140670843}
  botonVerdeLoEntendi: {fileID: 1209769217}
  botonResponderConfirmacion: {fileID: 1349577845}
  panelMinijuegoCards: {fileID: 1106084166}
  botonCajaDano: {fileID: 1839917775}
  botonCajaProteccion: {fileID: 1984793181}
  tarjetaCompartidaUI: {fileID: 1181629248}
  textoTarjetaCompartida: {fileID: 0}
  flashVerde: {fileID: 1541740185}
  flashRojo: {fileID: 2045162299}
  duracionFlash: 0.45
  tarjetas:
  - titulo: "Situaci\xF3n 1 (Vidrio)"
    textoSituacion: "Me cort\xE9 con un vidrio y la herida est\xE1 sangrando."
    esDanoConfirmado: 1
    retroAcierto: "\xA1Muy bien! Hay una lesi\xF3n f\xEDsica visible. El cuerpo nos
      avisa que necesita atenci\xF3n para cuidar la herida."
    retroFallo: "\xA1Vamos a intentarlo de nuevo! Observa que hay una herida reciente
      que podemos ver. Eso es una se\xF1al de da\xF1o f\xEDsico."
    objetoTarjetaPropia: {fileID: 1899170991}
  - titulo: "Situaci\xF3n 2 (Columna)"
    textoSituacion: "Me dijeron que tengo desgaste en la columna. Ahora tengo miedo
      de moverme y siento m\xE1s dolor cuando pienso que puedo empeorar."
    esDanoConfirmado: 0
    retroAcierto: "\xA1Muy bien! El miedo puede aumentar la alarma del sistema nervioso
      y hacer que el dolor se sienta m\xE1s intenso, pero no siempre significa da\xF1o
      activo."
    retroFallo: "\xA1Pi\xE9nsalo otra vez! El miedo y la preocupaci\xF3n influyen
      en el dolor. Un diagn\xF3stico no significa autom\xE1ticamente que est\xE9s
      da\xF1ando tu cuerpo."
    objetoTarjetaPropia: {fileID: 1265986446}
  - titulo: "Situaci\xF3n 3 (Sue\xF1o)"
    textoSituacion: "Dorm\xED muy mal y hoy siento m\xE1s dolor de espalda, aunque
      no me he lastimado."
    esDanoConfirmado: 0
    retroAcierto: "\xA1Exacto! Dormir mal puede hacer que el sistema nervioso est\xE9
      m\xE1s sensible y el dolor se sienta con mayor intensidad, incluso sin una
      lesi\xF3n."
    retroFallo: "La falta de sue\xF1o puede aumentar la sensibilidad al dolor. No
      siempre significa que haya una lesi\xF3n nueva."
    objetoTarjetaPropia: {fileID: 427024125}
  panelPreguntaFinal: {fileID: 80149457}
  botonOpcion4A: {fileID: 865504230}
  botonVerdeOpcion4A: {fileID: 73285072}
  botonOpcion4B: {fileID: 1973099205}
  botonVerdeOpcion4B: {fileID: 347371894}
