  m_Script: {fileID: 11500000, guid: d3372c34f510c514b8d3b2d007575ee6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Capitulo2.EstacionJuntaCapitulo2
  camaraEstacion: {fileID: 1658879776}
  transformCamara: {fileID: 1658879777}
  puntoCamaraGeneral: {fileID: 1796834132}
  duracionCloseUp: 1
  duracionVolverGeneral: 0.9
  nodos:
  - nombreNodo: Sensibilidad
    modelo3D: {fileID: 1636886784}
    botonNodo: {fileID: 542214355}
    botonVerde: {fileID: 517927347}
    grupoBoton: {fileID: 542214358}
    puntoCamaraCloseUp: {fileID: 166864671}
    etiquetaNombre: {fileID: 1859162499}
    dialogoEmocion: "Soy Sensibilidad. Yo recibo la se\xF1al y te lo hago saber \xA1Pero
      no soy yo quien decide cu\xE1nto te va a doler! "
    efectoLuz: {fileID: 2126347005}
    checkPulgar: {fileID: 1899698442}
  - nombreNodo: "Atenci\xF3n"
    modelo3D: {fileID: 1863978202}
    botonNodo: {fileID: 408663734}
    botonVerde: {fileID: 1282296802}
    grupoBoton: {fileID: 408663737}
    puntoCamaraCloseUp: {fileID: 343769956}
    etiquetaNombre: {fileID: 124065613}
    dialogoEmocion: "Soy Atenci\xF3n. Decido cu\xE1nto foco le das al dolor. Si est\xE1s
      distra\xEDd@, casi ni lo notas."
    efectoLuz: {fileID: 922990672}
    checkPulgar: {fileID: 1868863799}
  - nombreNodo: Miedo
    modelo3D: {fileID: 880095257}
    botonNodo: {fileID: 1067700381}
    botonVerde: {fileID: 264992094}
    grupoBoton: {fileID: 1067700384}
    puntoCamaraCloseUp: {fileID: 602577503}
    etiquetaNombre: {fileID: 1368576580}
    dialogoEmocion: Soy Miedo. Exagero el dolor cuando creo que hay peligro, pero
      solo quiero cuidarte...
    efectoLuz: {fileID: 1210335696}
    checkPulgar: {fileID: 594703156}
  - nombreNodo: Memoria
    modelo3D: {fileID: 582092510}
    botonNodo: {fileID: 192238091}
    botonVerde: {fileID: 1664777280}
    grupoBoton: {fileID: 192238094}
    puntoCamaraCloseUp: {fileID: 1612212388}
    etiquetaNombre: {fileID: 1756561193}
    dialogoEmocion: "Soy Memoria. Si algo parecido termin\xF3 mal antes, hago que
      esta vez duela m\xE1s fuerte"
    efectoLuz: {fileID: 883170088}
    checkPulgar: {fileID: 1016618129}
  - nombreNodo: "Motivaci\xF3n"
    modelo3D: {fileID: 1719911604}
    botonNodo: {fileID: 1960171347}
    botonVerde: {fileID: 1045093803}
    grupoBoton: {fileID: 1960171350}
    puntoCamaraCloseUp: {fileID: 526290798}
    etiquetaNombre: {fileID: 831199992}
    dialogoEmocion: "Soy Motivaci\xF3n. Si hay algo urgente que hacer, silencio el
      dolor por un rato."
    efectoLuz: {fileID: 1566484817}
    checkPulgar: {fileID: 929379469}
  - nombreNodo: "Estr\xE9s"
    modelo3D: {fileID: 1005390199}
    botonNodo: {fileID: 1088602036}
    botonVerde: {fileID: 2127990907}
    grupoBoton: {fileID: 1088602039}
    puntoCamaraCloseUp: {fileID: 1946426771}
    etiquetaNombre: {fileID: 1217644117}
    dialogoEmocion: "Soy Estr\xE9s. Cuando llevas mucho tiempo bajo presi\xF3n, todo
      empieza a doler m\xE1s f\xE1cil. "
    efectoLuz: {fileID: 1063421544}
    checkPulgar: {fileID: 188283993}
